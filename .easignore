# EAS Build — exclude everything not needed for the mobile app build.
# packages/shared IS needed (workspace dependency of apps/mobile).

# Claude Code internal directories (contain symlinks that break Windows archiving)
.agents
.claude

# Other apps — not needed to build apps/mobile
apps/api
apps/web-admin

# Docs
docs

# Misc
*.pem
.DS_Store

# Tooling — not needed to build apps/mobile.
# scripts/ad-campaign carries its own node_modules (~24 MB of sharp's native
# binaries), which would otherwise ride along in every EAS upload.
scripts
