# Turnos Web Admin — Environment Variables
# Copy this file to .env.local and adjust values for your setup.
# NEVER commit .env.local to git.

# ─── API URL ──────────────────────────────────────────────────────────────────
# Local development (API running on same machine):
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Staging / production:
# NEXT_PUBLIC_API_URL=https://api.turnos.pt/api
