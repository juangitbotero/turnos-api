# Turnos Mobile — Environment Variables
# Copy this file to .env and adjust values for your setup.
# NEVER commit .env to git.

# ─── API URL ──────────────────────────────────────────────────────────────────
# Simulator / emulator (localhost works because it runs on your machine):
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Physical device (phone on the same WiFi as your dev machine):
# Find your machine's local IP:
#   macOS/Linux: ifconfig | grep "inet " | grep -v 127
#   Windows:     ipconfig | findstr "IPv4"
# Then set:
# EXPO_PUBLIC_API_URL=http://192.168.1.X:3001/api

# ─── Google OAuth (optional — leave blank to hide Google Sign-In button) ──────
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── Node 24 workaround (uncomment if `expo start` will not start) ────────────
# Expo SDK 54 supports Node 20 and 22 LTS. On Node 24, `expo start` dies with
#   TypeError: Body is unusable: Body has already been read
# thrown by the startup dependency-version check, which reads a fetch Response
# body twice — Node 24's undici rejects that. It is a network call, so it fails
# intermittently rather than every time.
#
# The check only warns about version drift and never gates the build, so
# skipping it is safe. Run `npx expo-doctor` before a store build to get the
# same checks deliberately. Not needed on Node 20/22.
#
# See docs/web-admin-handoff.md, "The dev machine runs Node 24".
# EXPO_NO_DEPENDENCY_VALIDATION=1
