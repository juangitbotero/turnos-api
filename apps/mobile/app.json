{
  "expo": {
    "name": "Turnos",
    "slug": "turnos-mobile",
    "version": "0.0.1",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.turnos.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.turnos.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Turnos precisa de acesso às suas fotos para adicionar uma foto de perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Turnos needs location to verify you are at the shift location."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6366F1"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "A Turnos precisa de acesso ao calendário para adicionar os teus turnos confirmados."
        }
      ],
      "expo-document-picker",
      "expo-font",
      "expo-localization"
    ],
    "scheme": "turnos",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70e2e186-32e4-4a12-a795-ab7f674ef5ad"
      }
    }
  }
}
