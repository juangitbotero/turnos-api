# Turnos API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL + PostGIS) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=turnos
DB_PASSWORD=turnos_dev_password
DB_NAME=turnos_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ─── Twilio (SMS OTP) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=+351000000000

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=replace_me

# ─── Firebase (Push Notifications) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=replace_me
FIREBASE_CLIENT_EMAIL=replace_me
FIREBASE_PRIVATE_KEY=replace_me

# ─── File Storage (Cloudflare R2) ─────────────────────────────────────────────
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=turnos-files
