# =============================================================================
# Turnos API — Staging Environment
# Set these variables in your Railway/Fly.io dashboard.
# DO NOT commit this file with real values.
# =============================================================================

NODE_ENV=staging
PORT=3001

# Database (managed PostgreSQL on Railway/Fly.io)
DB_HOST=your-staging-db-host
DB_PORT=5432
DB_USER=turnos
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=turnos_db

# Redis (managed Redis on Railway/Fly.io)
REDIS_HOST=your-staging-redis-host
REDIS_PORT=6379

# Auth
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (use test keys for staging)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Twilio
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_PHONE_NUMBER=+351000000000

# Google Maps
GOOGLE_MAPS_API_KEY=replace_me

# Firebase
FIREBASE_PROJECT_ID=replace_me
FIREBASE_CLIENT_EMAIL=replace_me
FIREBASE_PRIVATE_KEY=replace_me

# File Storage (Cloudflare R2)
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=turnos-files-staging
